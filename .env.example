# ===== 邮箱 1（必填）=====
EMAIL1_ADDRESS=
EMAIL1_AUTH_CODE=
EMAIL1_SERVER=imap.163.com
EMAIL1_PORT=993

# ===== 邮箱 2（可选，有多个邮箱就接着填）=====
EMAIL2_ADDRESS=
EMAIL2_AUTH_CODE=
EMAIL2_SERVER=imap.163.com
EMAIL2_PORT=993

# 还可继续加 EMAIL3_*、EMAIL4_*…，地址和授权码都填了才会被抓取。

# ===== DeepSeek 配置 =====
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ===== 抓取与轮询 =====
# 拉取最近多少天的邮件（2 = 今天+昨天）
LOOKBACK_DAYS=2
# 刷新间隔（多久检查一次新邮件）在网页看板右上角「⚙️ 刷新设置」里改，默认 60 分钟
# 发给 DeepSeek 的正文最长字符数
MAX_BODY_CHARS=3000
